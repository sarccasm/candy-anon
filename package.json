{
  "name": "candy-anon-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "local:up": "docker compose -p candy-anon-local -f compose.local.yml up -d",
    "local:setup": "node edge/scripts/setup-local.mjs",
    "local:down": "docker compose -p candy-anon-local -f compose.local.yml down",
    "test:e2e": "node scripts/local-e2e.mjs",
    "local:edge": "node scripts/local-run.mjs edge",
    "local:bridge": "node scripts/local-run.mjs bridge",
    "local:frontend": "node scripts/local-run.mjs frontend",
    "migration:plan": "node edge/scripts/plan-legacy-migration.mjs",
    "test": "node --test tests/*.test.mjs frontend/tests/*.test.mjs",
    "preflight": "node scripts/security-preflight.mjs",
    "legacy:check": "node edge/scripts/reconcile-legacy.mjs",
    "secrets:audit": "node scripts/audit-historical-credentials.mjs",
    "cloud:plan": "node scripts/cloud-hardening.mjs",
    "cloud:audit": "node scripts/cloud-hardening.mjs --audit",
    "cloud:login": "node scripts/azure-login.mjs",
    "cloud:apply": "node scripts/cloud-hardening.mjs --apply",
    "migration:dataset": "node edge/scripts/migrate-dataset.mjs"
  },
  "devDependencies": {
    "node": "22.23.4",
    "playwright": "1.64.1"
  }
}
